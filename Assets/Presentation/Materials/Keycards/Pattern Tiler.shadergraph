{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "2479145225b4414c804cfe89ac75a21c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "PatternTile (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1000.0,
            "y": -300.0,
            "width": 380.0,
            "height": 480.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "5d14dd2564fa4fccb2039dcfaf81bc2a"
        },
        {
            "m_Id": "783a3abd2ecf418e897ec6f6689ee543"
        },
        {
            "m_Id": "fa0c7b1c30434885a475239ba09306bb"
        },
        {
            "m_Id": "019f9d55a37743cab6b6f916519668fe"
        },
        {
            "m_Id": "4e1b572e7e29418eb4ac7d890f471117"
        },
        {
            "m_Id": "54619006bf5a4a759b756912e02bc4d2"
        },
        {
            "m_Id": "ce8ec83ea3ec49ddbb21c1a49a969d68"
        },
        {
            "m_Id": "5a33c033f90348cbb91ef782b9ee328e"
        },
        {
            "m_Id": "1f5b96b2724e46abb444696798690303"
        },
        {
            "m_Id": "c717dcd5d0f14fb9a40d48089f4d8ebc"
        },
        {
            "m_Id": "2a776741ec1a4e67ae8c9c57419675d8"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PatternTile",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "\n    float3 n = normalize(NormalOS);\n\n    // How much this surface faces each axis.\n    float3 blend = pow(abs(n), max(CornerSharpness, 1.0));\n    blend /= max(blend.x + blend.y + blend.z, 1e-5);\n\n    // Object space, scaled up by the object's world scale. Object space keeps\n    // the pattern nailed to the model, so a keycard you pick up carries its\n    // chevrons with it instead of swimming through a pattern fixed in the\n    // world. Multiplying by the scale keeps sizes in real metres, so the\n    // same numbers work on objects of different sizes.\n    float3x3 o2w = (float3x3)GetObjectToWorldMatrix();\n    float3 objectScale = float3(\n        length(float3(o2w[0][0], o2w[1][0], o2w[2][0])),\n        length(float3(o2w[0][1], o2w[1][1], o2w[2][1])),\n        length(float3(o2w[0][2], o2w[1][2], o2w[2][2])));\n\n    float3 p = PositionOS * objectScale;\n    float3 dpx = ddx(p);\n    float3 dpy = ddy(p);\n\n    // The Pattern texture is a strip of IconCount icons side by side sharing\n    // one sampler, so any number of icons costs exactly one texture unit.\n    float count = max(round(IconCount), 1.0);\n\n    // Everything is in metres. One icon keeps its own aspect -- texelSize.zw\n    // is the whole strip's pixel size, so divide the width by the count to\n    // get a single icon's.\n    float aspect = (Pattern.texelSize.z / count) / max(Pattern.texelSize.w, 1e-5);\n    float iconH = max(IconHeight, 1e-4);\n    float iconW = iconH * aspect;\n    float cellW = max(iconW + GapX, 1e-4);\n    float cellH = max(iconH + GapY, 1e-4);\n    float fw = iconW / cellW;\n    float fh = iconH / cellH;\n\n    float coverage = 0.0;\n\n    [unroll]\n    for (int i = 0; i < 3; i++)\n    {\n        float2 q, dqx, dqy;\n        float w;\n\n        if (i == 0)\n        {\n            float s = n.x < 0.0 ? 1.0 : -1.0;   // keep facing consistent\n            q   = float2(p.z * s,   p.y);\n            dqx = float2(dpx.z * s, dpx.y);\n            dqy = float2(dpy.z * s, dpy.y);\n            w   = blend.x;\n        }\n        else if (i == 1)\n        {\n            float s = n.y < 0.0 ? -1.0 : 1.0;\n            q   = float2(p.x * s,   p.z);\n            dqx = float2(dpx.x * s, dpx.z);\n            dqy = float2(dpy.x * s, dpy.z);\n            w   = blend.y;\n        }\n        else\n        {\n            float s = n.z < 0.0 ? -1.0 : 1.0;\n            q   = float2(p.x * s,   p.y);\n            dqx = float2(dpx.x * s, dpx.y);\n            dqy = float2(dpy.x * s, dpy.y);\n            w   = blend.z;\n        }\n\n        if (w < 1e-4)\n            continue;\n\n        // Grid, with every row stepped across so no two rows share a phase.\n        // Subtracting shifts the pattern right; adding would step it the\n        // opposite way from the Python tiler and the two wouldn't match.\n        float2 g = float2(q.x / cellW, q.y / cellH);\n        g.x -= floor(g.y) * RowShift;\n\n        float2 cell = frac(g);\n        float2 uv = (cell - 0.5) / float2(fw, fh) + 0.5;\n\n        // Derivatives from the continuous coordinate, not the wrapped one --\n        // frac() would otherwise blow up the mip level at every cell edge.\n        float2 duvx = float2(dqx.x / cellW / fw, dqx.y / cellH / fh);\n        float2 duvy = float2(dqy.x / cellW / fw, dqy.y / cellH / fh);\n\n        float inside = (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0) ? 1.0 : 0.0;\n\n        // Which icon this cell gets. Summing the two cell indices cycles\n        // through the strip along both axes, so with two icons neighbours\n        // alternate like a checkerboard, with three every third differs, and\n        // so on. Entirely positional -- no randomness, same every frame.\n        float pick = fmod(fmod(floor(g.x) + floor(g.y), count) + count, count);\n\n        // Fold into the icon's slice of the strip.\n        float2 stripUV = float2((pick + saturate(uv.x)) / count, saturate(uv.y));\n        duvx.x /= count;\n        duvy.x /= count;\n\n        float alpha = Pattern.SampleGrad(Pattern.samplerstate, stripUV, duvx, duvy).a;\n\n        coverage += w * alpha * inside;\n    }\n\n    Shade = 1.0 - saturate(coverage) * Contrast;\n"
}

