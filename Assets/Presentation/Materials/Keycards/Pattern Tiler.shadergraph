{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "bc383703df264f189e4ad42b3970d929",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "PatternTile (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1000.0,
            "y": -300.0,
            "width": 380.0,
            "height": 480.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "f2f482bacece4e968eb41a1d03160b4e"
        },
        {
            "m_Id": "6cfd0c7770e748009cd45cd56b9fab1a"
        },
        {
            "m_Id": "0c645a92b0fe40b994c7339485f04924"
        },
        {
            "m_Id": "25aedb68251746af8260c70cad60637a"
        },
        {
            "m_Id": "e7bf5b26032d47579e8ba4cd48aa4c98"
        },
        {
            "m_Id": "a9e6ed6c27f242a38eb16b0c0eae31b4"
        },
        {
            "m_Id": "8b9812a0661d4eea90e2db0fc4b68e73"
        },
        {
            "m_Id": "dfbcfa231d0e4009a597efb99c3aa6b8"
        },
        {
            "m_Id": "3416e2e3814b41bb9b875b760b0ec73a"
        },
        {
            "m_Id": "00f0717c23af422dae20a7b9b174d6a6"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PatternTile",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "\n    float3 n = normalize(NormalOS);\n\n    // How much this surface faces each axis.\n    float3 blend = pow(abs(n), max(CornerSharpness, 1.0));\n    blend /= max(blend.x + blend.y + blend.z, 1e-5);\n\n    // Object space, scaled up by the object's world scale. Object space keeps\n    // the pattern nailed to the model, so a keycard you pick up carries its\n    // chevrons with it instead of swimming through a pattern fixed in the\n    // world. Multiplying by the scale keeps sizes in real metres, so the\n    // same numbers work on objects of different sizes.\n    float3x3 o2w = (float3x3)GetObjectToWorldMatrix();\n    float3 objectScale = float3(\n        length(float3(o2w[0][0], o2w[1][0], o2w[2][0])),\n        length(float3(o2w[0][1], o2w[1][1], o2w[2][1])),\n        length(float3(o2w[0][2], o2w[1][2], o2w[2][2])));\n\n    float3 p = PositionOS * objectScale;\n    float3 dpx = ddx(p);\n    float3 dpy = ddy(p);\n\n    // Every icon is one slice of a Texture2DArray: a single sampler and a\n    // single bind however many there are, and each slice is its own image, so\n    // neighbours can never bleed into each other in the lower mips.\n    //\n    // The count is the array's own depth. Nothing to keep in sync and nothing\n    // to set: add an icon to the list, rebuild the asset, and the pattern\n    // picks it up.\n    uint texW, texH, sliceCount;\n    Icons.tex.GetDimensions(texW, texH, sliceCount);\n    float count = max((float)sliceCount, 1.0);\n\n    // Everything is in metres. Slices all share one size, so that size is the\n    // cell's aspect; each icon keeps its own proportions inside its slice.\n    float aspect = (float)texW / max((float)texH, 1e-5);\n    float iconH = max(IconHeight, 1e-4);\n    float iconW = iconH * aspect;\n    float cellW = max(iconW + GapX, 1e-4);\n    float cellH = max(iconH + GapY, 1e-4);\n    float fw = iconW / cellW;\n    float fh = iconH / cellH;\n\n    float coverage = 0.0;\n\n    [unroll]\n    for (int i = 0; i < 3; i++)\n    {\n        float2 q, dqx, dqy;\n        float w;\n\n        if (i == 0)\n        {\n            float s = n.x < 0.0 ? 1.0 : -1.0;   // keep facing consistent\n            q   = float2(p.z * s,   p.y);\n            dqx = float2(dpx.z * s, dpx.y);\n            dqy = float2(dpy.z * s, dpy.y);\n            w   = blend.x;\n        }\n        else if (i == 1)\n        {\n            float s = n.y < 0.0 ? -1.0 : 1.0;\n            q   = float2(p.x * s,   p.z);\n            dqx = float2(dpx.x * s, dpx.z);\n            dqy = float2(dpy.x * s, dpy.z);\n            w   = blend.y;\n        }\n        else\n        {\n            float s = n.z < 0.0 ? -1.0 : 1.0;\n            q   = float2(p.x * s,   p.y);\n            dqx = float2(dpx.x * s, dpx.y);\n            dqy = float2(dpy.x * s, dpy.y);\n            w   = blend.z;\n        }\n\n        if (w < 1e-4)\n            continue;\n\n        // Grid, with every row stepped across so no two rows share a phase.\n        // Subtracting shifts the pattern right; adding would step it the\n        // opposite way from the Python tiler and the two wouldn't match.\n        float2 g = float2(q.x / cellW, q.y / cellH);\n        g.x -= floor(g.y) * RowShift;\n\n        float2 cell = frac(g);\n        float2 uv = (cell - 0.5) / float2(fw, fh) + 0.5;\n\n        // Derivatives from the continuous coordinate, not the wrapped one --\n        // frac() would otherwise blow up the mip level at every cell edge.\n        float2 duvx = float2(dqx.x / cellW / fw, dqx.y / cellH / fh);\n        float2 duvy = float2(dqy.x / cellW / fw, dqy.y / cellH / fh);\n\n        float inside = (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0) ? 1.0 : 0.0;\n\n        // Which icon this cell gets. Summing the two cell indices cycles\n        // through the list along both axes, so with two icons neighbours\n        // alternate like a checkerboard, with three every third differs, and\n        // so on. Entirely positional -- no randomness, same every frame.\n        float pick = fmod(fmod(floor(g.x) + floor(g.y), count) + count, count);\n\n        float alpha = Icons.SampleGrad(Icons.samplerstate,\n                                       float3(saturate(uv), pick), duvx, duvy).a;\n\n        coverage += w * alpha * inside;\n    }\n\n    Shade = 1.0 - saturate(coverage) * Contrast;\n"
}

